    "bug.descriptionPlaceholder": {
      "comment": "Placeholder of the report description field",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خطوات تكرار المشكلة، وما كنت تتوقعه، وما حدث فعلًا…"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Passos per reproduir-ho, què esperaves, què ha passat realment…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schritte zum Nachstellen, was du erwartet hast, was tatsächlich passiert ist…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steps to reproduce, what you expected, what actually happened…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasos para reproducirlo, qué esperabas, qué pasó realmente…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Étapes pour reproduire, ce que vous attendiez, ce qui s'est réellement passé…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समस्या दोहराने के चरण, आपको क्या उम्मीद थी, असल में क्या हुआ…"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Langkah untuk mengulanginya, apa yang Anda harapkan, apa yang sebenarnya terjadi…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passaggi per riprodurlo, cosa ti aspettavi, cosa è successo davvero…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再現手順、期待した動作、実際に起きたこと…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재현 방법, 예상한 결과, 실제로 일어난 일…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stappen om het te reproduceren, wat je verwachtte, wat er echt gebeurde…"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak odtworzyć błąd, czego oczekiwano, co faktycznie się stało…"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Passos para reproduzir, o que você esperava, o que realmente aconteceu…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Passos para reproduzir, o que você esperava, o que realmente aconteceu…"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Passos para reproduzir, o que esperava, o que aconteceu realmente…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаги для воспроизведения, что вы ожидали, что произошло на самом деле…"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขั้นตอนที่ทำให้เกิดปัญหา สิ่งที่คุณคาดไว้ สิ่งที่เกิดขึ้นจริง…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorunu tekrarlama adımları, ne beklediğiniz, gerçekte ne olduğu…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bước tái hiện, điều bạn mong đợi, điều thực sự đã xảy ra…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复现步骤、你预期的结果、实际发生的情况…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重現步驟、你預期的結果、實際發生的情況…"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinyathelo zokuphinda inkinga, obukulindele, okwenzeke ngempela…"
          }
        }
      }
    },
    "bug.emailHint": {
      "comment": "Help text below the email field",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليس مطلوبًا، لكن بريدك الإلكتروني يساعدنا على طرح أسئلة إضافية وحل المشكلة بشكل أسرع."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No és obligatori, però amb el teu correu et podem fer preguntes i solucionar el problema més ràpid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht erforderlich, aber mit deiner E-Mail können wir Rückfragen stellen und das Problem schneller beheben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not required, but an email helps us ask follow-up questions and fix the issue faster."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No es obligatorio, pero con tu correo podemos hacerte preguntas y solucionar el problema más rápido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif, mais votre e-mail nous permet de vous poser des questions et de corriger le problème plus vite."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ज़रूरी नहीं है, लेकिन ईमेल से हम आगे के सवाल पूछ सकते हैं और समस्या जल्दी ठीक कर सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak wajib, tetapi dengan email kami bisa mengajukan pertanyaan lanjutan dan memperbaiki masalah lebih cepat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è obbligatoria, ma con un'email possiamo farti domande e risolvere il problema più in fretta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意ですが、メールアドレスがあれば追加で質問でき、より早く問題を解決できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필수는 아니지만 이메일을 남겨 주시면 추가 질문을 드리고 더 빨리 문제를 해결할 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet verplicht, maar met je e-mail kunnen we je vragen stellen en het probleem sneller oplossen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie jest wymagany, ale dzięki adresowi e-mail możemy zadać dodatkowe pytania i szybciej rozwiązać problem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é obrigatório, mas com seu e-mail podemos fazer perguntas e corrigir o problema mais rápido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é obrigatório, mas com seu e-mail podemos fazer perguntas e corrigir o problema mais rápido."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é obrigatório, mas com o seu e-mail podemos colocar-lhe perguntas e resolver o problema mais depressa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необязательно, но с адресом почты мы сможем задать уточняющие вопросы и быстрее решить проблему."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่บังคับ แต่อีเมลช่วยให้เราสอบถามเพิ่มเติมและแก้ไขปัญหาได้เร็วขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zorunlu değil, ancak e-posta adresiniz sayesinde size soru sorabilir ve sorunu daha hızlı çözebiliriz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không bắt buộc, nhưng email giúp chúng tôi hỏi thêm thông tin và khắc phục sự cố nhanh hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "非必填，但留下电子邮件可以让我们向你询问细节，更快解决问题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "非必填，但留下電子郵件可讓我們向你詢問細節，更快解決問題。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Akuphoqelekile, kodwa i-imeyili isisiza ukuthi sikubuze imibuzo futhi silungise inkinga ngokushesha."
          }
        }
      }
    },
