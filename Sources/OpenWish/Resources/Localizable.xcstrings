        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 답변이 없어요. 확인 후 여기에서 답변드릴게요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen reacties. We reageren hier zodra we ernaar hebben gekeken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak odpowiedzi. Odpowiemy tutaj, gdy tylko się temu przyjrzymy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há respostas. Responderemos aqui assim que analisarmos."
