    "bug.errorPhotoLoad": {
      "comment": "Error",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحميل لقطة الشاشة من الصور. يرجى تجربة صورة أخرى."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'ha pogut carregar la captura des de Fotos. Prova una altra imatge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Screenshot konnte nicht aus Fotos geladen werden. Bitte wähle ein anderes Bild."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not load screenshot from Photos. Please try another image."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido cargar la captura desde Fotos. Prueba con otra imagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger la capture depuis Photos. Veuillez essayer une autre image."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तस्वीरें से स्क्रीनशॉट लोड नहीं हो सका। कृपया कोई दूसरी इमेज आज़माएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat memuat tangkapan layar dari Foto. Silakan coba gambar lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare lo screenshot da Foto. Prova con un'altra immagine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真からスクリーンショットを読み込めませんでした。別の画像をお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 앱에서 스크린샷을 불러올 수 없어요. 다른 이미지를 선택해 주세요."
          }
        },
        "nl": {
