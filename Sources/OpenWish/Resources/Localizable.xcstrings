    "wish.voteFailed": {
      "comment": "Alert when a vote could not be sent",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدث خطأ أثناء التصويت. حاول مرة أخرى لاحقًا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguna cosa ha fallat amb el teu vot. Torna-ho a provar més tard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei deiner Stimmabgabe ist etwas schiefgelaufen. Versuch es später noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong during your vote. Try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo salió mal al registrar tu voto. Inténtalo de nuevo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un problème est survenu lors de votre vote. Réessayez plus tard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका वोट दर्ज करते समय कुछ गलत हो गया। बाद में फिर से कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjadi kesalahan saat memberi suara. Coba lagi nanti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si è verificato un problema con il tuo voto. Riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投票中に問題が発生しました。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "투표 중 문제가 발생했어요. 나중에 다시 시도해 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er ging iets mis bij het stemmen. Probeer het later opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coś poszło nie tak podczas głosowania. Spróbuj ponownie później."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo deu errado com seu voto. Tente novamente mais tarde."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo deu errado com seu voto. Tente novamente mais tarde."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocorreu um erro ao registar o seu voto. Tente novamente mais tarde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось учесть ваш голос. Повторите попытку позже."
