    "bug.cardNotConnected": {
      "comment": "Shown when the app has no card search",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يربط هذا التطبيق قاعدة بيانات البطاقات الخاصة به. أرفق صورة وصِف البطاقة أدناه."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquesta app no ha connectat la seva base de dades de cartes. Adjunta una foto i descriu la carta a sota."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App hat ihre Kartendatenbank nicht angebunden. Hänge ein Foto an und beschreibe die Karte unten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app has not connected its card database. Attach a photo and describe the card below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta app no ha conectado su base de datos de cartas. Adjunta una foto y describe la carta abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette app n'a pas connecté sa base de données de cartes. Joignez une photo et décrivez la carte ci-dessous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस ऐप ने अपना कार्ड डेटाबेस कनेक्ट नहीं किया है। एक फ़ोटो जोड़ें और नीचे कार्ड का विवरण दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi ini belum menghubungkan database kartunya. Lampirkan foto dan jelaskan kartunya di bawah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa app non ha collegato il suo database di carte. Allega una foto e descrivi la carta qui sotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリはカードデータベースに接続されていません。写真を添付し、下にカードの説明を入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱은 카드 데이터베이스가 연결되어 있지 않아요. 사진을 첨부하고 아래에 카드를 설명해 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze app heeft zijn kaartdatabase niet gekoppeld. Voeg een foto toe en beschrijf de kaart hieronder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta aplikacja nie połączyła swojej bazy kart. Dołącz zdjęcie i opisz kartę poniżej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este app não conectou seu banco de dados de cartas. Anexe uma foto e descreva a carta abaixo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este app não conectou seu banco de dados de cartas. Anexe uma foto e descreva a carta abaixo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta app não ligou a sua base de dados de cartas. Anexe uma fotografia e descreva a carta abaixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это приложение не подключило свою базу карт. Прикрепите фото и опишите карту ниже."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปนี้ยังไม่ได้เชื่อมต่อฐานข้อมูลการ์ด โปรดแนบรูปภาพและอธิบายการ์ดด้านล่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulama kart veritabanını bağlamadı. Bir fotoğraf ekleyin ve kartı aşağıda tarif edin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng này chưa kết nối cơ sở dữ liệu thẻ. Hãy đính kèm ảnh và mô tả thẻ bên dưới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 App 尚未连接其卡牌数据库。请附上照片并在下方描述该卡牌。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 App 尚未連接其卡牌資料庫。請附上照片並在下方描述這張卡牌。"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Le app ayikaxhumi isizindalwazi sayo samakhadi. Namathisela isithombe bese uchaza ikhadi ngezansi."
          }
        }
      }
    },
