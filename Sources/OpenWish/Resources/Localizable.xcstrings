    "bug.cardDescriptionPlaceholder": {
      "comment": "Placeholder of the description field for card reports",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما الخطأ في البطاقة أو في التعرّف عليها؟"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Què hi ha de malament en la carta o en la detecció?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was stimmt mit der Karte oder der Erkennung nicht?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is wrong with the card or the detection?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué está mal en la carta o en la detección?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce qui ne va pas avec la carte ou la détection ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्ड या पहचान में क्या गलत है?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang salah dengan kartu atau deteksinya?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa c'è di sbagliato nella carta o nel riconoscimento?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カードまたは認識結果のどこが間違っていますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카드나 인식 결과에 어떤 문제가 있나요?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat klopt er niet aan de kaart of de herkenning?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co jest nie tak z kartą lub rozpoznawaniem?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que está errado com a carta ou com o reconhecimento?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que está errado com a carta ou com o reconhecimento?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O que está errado com a carta ou com o reconhecimento?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что не так с картой или распознаванием?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การ์ดหรือการตรวจจับผิดพลาดตรงไหน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartta veya tanımada yanlış olan ne?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thẻ hoặc kết quả nhận diện bị sai ở đâu?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卡牌或识别结果有什么问题？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "卡牌或辨識結果有什麼問題？"
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Yini engalungile ngekhadi noma ngokuhlonzwa kwalo?"
          }
        }
      }
    },
    "bug.cardNoResults": {
      "comment": "Card search found nothing",
      "extractionState": "manual",
